# PulseTriage — environment template
#
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# Every value below is a placeholder.

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Managed PostgreSQL connection string (Neon / Supabase / any Postgres host).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── AI assistants (OPTIONAL) ─────────────────────────────────────────────────
# When OLLAMA_API_KEY is absent the AI-assisted features return their
# deterministic fallbacks. The rule-based triage engine is unaffected and the
# application runs normally without this key.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
# Single-model default. Must be a model Ollama Cloud actually hosts —
# see https://ollama.com/library or GET https://ollama.com/api/tags.
OLLAMA_MODEL=gemma4:31b
# Ensemble roster, best-first, comma separated. The clinical helpers fan a
# prompt out to the first few of these in parallel and return the answer the
# panel agrees on. Entries the account is not entitled to are skipped
# automatically after the first 403.
OLLAMA_MODELS=kimi-k3,deepseek-v4-pro,gemma4:31b,gpt-oss:120b,minimax-m3,nemotron-3-nano:30b
# Per-model request budget in ms.
OLLAMA_TIMEOUT_MS=25000

# ── Application (OPTIONAL) ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
