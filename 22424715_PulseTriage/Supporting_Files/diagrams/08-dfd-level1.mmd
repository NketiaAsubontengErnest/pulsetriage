flowchart LR
  PT["External Entity<br/>PATIENT"]
  DR["External Entity<br/>DOCTOR"]
  AD["External Entity<br/>ADMINISTRATOR"]
  AI["External Entity<br/>OLLAMA CLOUD LLM"]

  P1["1.0<br/>Authenticate &<br/>Authorise User"]
  P2["2.0<br/>Evaluate Symptom<br/>Triage Rules"]
  P3["3.0<br/>Search Doctors &<br/>Reserve Slot"]
  P4["4.0<br/>Process Simulated<br/>Payment"]
  P5["5.0<br/>Dispatch<br/>Notifications"]
  P6["6.0<br/>Conduct & Record<br/>Consultation"]
  P7["7.0<br/>Administer &<br/>Audit System"]

  D1[("D1 users")]
  D2[("D2 triage_assessments")]
  D3[("D3 doctors / doctor_schedules")]
  D4[("D4 appointments")]
  D5[("D5 payment_logs")]
  D6[("D6 notifications")]
  D7[("D7 audit_logs")]

  PT -->|credentials| P1
  DR -->|credentials| P1
  AD -->|credentials| P1
  P1 <-->|user record + bcrypt hash| D1
  P1 -->|session profile| PT

  PT -->|symptom, duration, pain, red flags| P2
  P2 <-->|assessment record| D2
  P2 -->|urgency, score, specialty| PT
  P2 -.->|optional NL description| AI
  AI -.->|structured AI triage JSON| P2

  PT -->|specialty / date filter| P3
  P3 <-->|availability| D3
  P3 <-->|appointment record| D4
  P3 -->|booking summary| PT

  PT -->|payment method + account| P4
  P4 <-->|transaction record| D5
  P4 -->|status update| D4
  P4 -->|receipt| PT

  P2 --> P5
  P3 --> P5
  P4 --> P5
  P5 <-->|queued messages| D6
  P5 -->|alerts| PT
  P5 -->|new booking alert| DR

  DR -->|clinical / SOAP notes| P6
  P6 <-->|notes + status| D4
  P6 -.->|transcript| AI
  AI -.->|SOAP JSON| P6
  P6 -->|completed consultation| PT

  AD -->|verification, rules, config| P7
  P7 <-->|doctor records| D3
  P7 <-->|read-only| D2
  P7 <-->|read-only| D5
  P1 --> D7
  P2 --> D7
  P3 --> D7
  P4 --> D7
  P7 <-->|audit trail| D7
  P7 -->|metrics + audit views| AD
